# =============================================================================
# LumenForge — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Required vars are marked as [REQUIRED].
#
# There are no auth provider keys: sign-in is part of the app, and sessions
# live in the database.
# =============================================================================

# Node environment
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database — Turso / libSQL                           [REQUIRED]
#   Local dev:   file:./data/lumenforge.db
#   Production:  libsql://your-db-org.turso.io
# ---------------------------------------------------------------------------
TURSO_DATABASE_URL=file:./data/lumenforge.db
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Groq AI                                               [OPTIONAL]
#   Get your key at https://console.groq.com
#   AI features (proposals, summaries) will be disabled without this.
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# App URL                                               [REQUIRED for production]
#   Set to your production URL when deploying.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
